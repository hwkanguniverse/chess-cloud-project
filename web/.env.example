# Copy to .env and fill in from Terraform outputs:
#
#   terraform -chdir=../terraform/api  output -raw api_endpoint
#   terraform -chdir=../terraform/auth output -raw user_pool_id
#   terraform -chdir=../terraform/auth output -raw user_pool_client_id
#
# VITE_ prefix is required: Vite only exposes variables with that prefix to the
# browser bundle. That is a safety feature, not a convention - it makes leaking
# a server-side secret into client JavaScript an explicit act rather than an
# accident. Nothing here is secret: the pool id and client id are public by
# design (the client has no secret, which is why PKCE exists), and the API URL
# is visible in every request the app makes.

VITE_API_URL=https://a6k5kq6jtc.execute-api.ap-southeast-1.amazonaws.com
VITE_USER_POOL_ID=ap-southeast-1_yyC60zz04
VITE_USER_POOL_CLIENT_ID=1f7u5irjkvjllt15al80g0osqt
